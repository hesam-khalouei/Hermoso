generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// کاربران
// ═══════════════════════════════════════
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

// ═══════════════════════════════════════
// تم‌ها (رنگ + فونت)
// ═══════════════════════════════════════
model Theme {
  id            String   @id @default(cuid())
  name          String
  // رنگ‌ها (hex)
  primary       String   @default("#14B8A6")
  secondary     String   @default("#FB923C")
  accent        String   @default("#06B6D4")
  text          String   @default("#18181B")
  textMuted     String   @default("#71717A")
  background    String   @default("#FFFFFF")
  backgroundDark String  @default("#030712")
  border        String   @default("#E4E4E7")
  // فونت
  fontFamily    String   @default("Vazirmatn")
  // شکل
  radius        String   @default("16px")
  // custom
  customCss     String?
  isDefault     Boolean  @default(false)

  sites         Site[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════
// سایت‌ها
// ═══════════════════════════════════════
model Site {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  domain       String?  @unique
  logo         String?
  favicon      String?
  isActive     Boolean  @default(true)

  themeId      String?
  theme        Theme?   @relation(fields: [themeId], references: [id])

  pages        Page[]
  media        Media[]
  forms        Form[]
  submissions  Submission[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════
// صفحات
// ═══════════════════════════════════════
model Page {
  id             String   @id @default(cuid())
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  title          String
  slug           String   @default("home")
  isHome         Boolean  @default(false)

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  blocks         Block[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([siteId, slug])
}

// ═══════════════════════════════════════
// بلاک‌ها
// ═══════════════════════════════════════
model Block {
  id             String   @id @default(cuid())
  pageId         String
  page           Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  blockType      String   // "hero", "timeline", "features", ...
  variant        String   @default("v1") // "v1", "v2", "v3"
  orderIndex     Int      @default(0)
  isVisible      Boolean  @default(true)

  content        Json     // تمام محتوای بلاک
  styles         Json?    // override های ظاهری

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([pageId, orderIndex])
}

// ═══════════════════════════════════════
// رسانه‌ها
// ═══════════════════════════════════════
model Media {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  filename   String
  url        String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  alt        String?

  createdAt  DateTime @default(now())
}

// ═══════════════════════════════════════
// فرم‌ها
// ═══════════════════════════════════════
model Form {
  id             String       @id @default(cuid())
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name           String
  fields         Json         // تعریف فیلدهای فرم
  successMessage String       @default("پیام شما با موفقیت ارسال شد")

  submissions    Submission[]
  createdAt      DateTime     @default(now())
}

// ═══════════════════════════════════════
// پیام‌های دریافتی
// ═══════════════════════════════════════
model Submission {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  formId     String?
  form       Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)

  data       Json     // { name: "...", email: "...", message: "..." }
  isRead     Boolean  @default(false)
  ip         String?
  userAgent  String?

  createdAt  DateTime @default(now())
}

// ═══════════════════════════════════════
// تنظیمات عمومی
// ═══════════════════════════════════════
model Setting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
}